<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Academia Digital · Treinamentos de Ferramentas</title>
  <meta name="description" content="Trilhas de treinamento em ferramentas digitais: Power Apps, Seeq, PI Vision e mais." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <!-- Fundo animado -->
  <div class="bg-orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <!-- Header -->
  <header class="header">
    <div class="brand">
      <span class="brand-mark">◆</span>
      <span class="brand-name">Academia <strong>Digital</strong></span>
    </div>
    <nav class="nav">
      <a href="#trilhas">Trilhas</a>
      <a href="#recursos">Recursos</a>
      <a href="#agenda">Agenda</a>
    </nav>
    <button id="themeToggle" class="theme-toggle" aria-label="Alternar tema" title="Alternar tema">
      <span class="theme-icon">🌙</span>
    </button>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow">Transformação Digital</span>
      <h1 class="hero-title">Capacite-se nas ferramentas que transformam <span class="grad">dados em decisões</span>.</h1>
      <p class="hero-sub">Trilhas de aprendizado práticas em Power Apps, Seeq, PI Vision e outras ferramentas que aceleram a inovação no dia a dia.</p>
      <div class="hero-actions">
        <a href="#trilhas" class="btn btn-primary">Explorar trilhas</a>
        <a href="#agenda" class="btn btn-ghost">Próximas turmas</a>
      </div>
      <div class="stats">
        <div class="stat"><span class="stat-num" data-count="320">0</span><span class="stat-label">Pessoas treinadas</span></div>
        <div class="stat"><span class="stat-num" data-count="6">0</span><span class="stat-label">Ferramentas</span></div>
        <div class="stat"><span class="stat-num" data-count="48">0</span><span class="stat-label">Horas de conteúdo</span></div>
      </div>
    </div>
  </section>

  <!-- Trilhas -->
  <section id="trilhas" class="section">
    <div class="section-head">
      <h2>Trilhas de aprendizado</h2>
      <p>Escolha uma ferramenta e evolua do básico ao avançado.</p>
    </div>

    <div class="toolbar">
      <div class="search">
        <span class="search-icon">🔍</span>
        <input id="searchInput" type="text" placeholder="Buscar ferramenta..." aria-label="Buscar" />
      </div>
      <div class="filters" id="filters">
        <button class="chip active" data-level="all">Todos</button>
        <button class="chip" data-level="Iniciante">Iniciante</button>
        <button class="chip" data-level="Intermediário">Intermediário</button>
        <button class="chip" data-level="Avançado">Avançado</button>
      </div>
    </div>

    <div class="grid" id="cardsGrid"><!-- cards injetados via JS --></div>
    <p id="emptyState" class="empty" hidden>Nenhum treinamento encontrado. Tente outro termo. 🤔</p>
  </section>

  <!-- Recursos rápidos -->
  <section id="recursos" class="section">
    <div class="section-head">
      <h2>Recursos rápidos</h2>
      <p>Materiais de apoio para consultar quando precisar.</p>
    </div>
    <div class="resources">
      <a class="resource" href="#"><span class="res-ic">🎬</span><div><strong>Vídeos tutoriais</strong><small>Passo a passo em vídeo</small></div></a>
      <a class="resource" href="#"><span class="res-ic">📄</span><div><strong>Guias em PDF</strong><small>Materiais para download</small></div></a>
      <a class="resource" href="#"><span class="res-ic">📚</span><div><strong>Documentação</strong><small>Referências oficiais</small></div></a>
      <a class="resource" href="#"><span class="res-ic">💬</span><div><strong>Comunidade</strong><small>Tire dúvidas com o time</small></div></a>
    </div>
  </section>

  <!-- Agenda -->
  <section id="agenda" class="section">
    <div class="section-head">
      <h2>Próximas turmas</h2>
      <p>Treinamentos ao vivo agendados.</p>
    </div>
    <div class="agenda" id="agendaList"><!-- injetado via JS --></div>
  </section>

  <footer class="footer">
    <p>Academia Digital · Transformação Digital · Feito com 🧡 para inovar</p>
  </footer>

  <script src="app.js"></script>
</body>
</html>
